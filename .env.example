# FlowPilot Environment Configuration Template
FLOWPILOT_ENVIRONMENT=development
FLOWPILOT_DATABASE_URL=postgresql+asyncpg://flowpilot:flowpilot@localhost:5432/flowpilot
FLOWPILOT_REDIS_URL=redis://localhost:6379/0
FLOWPILOT_TEMPORAL_ADDRESS=localhost:7233
FLOWPILOT_TEMPORAL_NAMESPACE=default
FLOWPILOT_EXECUTION_MODE=local
FLOWPILOT_S3_ENDPOINT_URL=http://localhost:9000
FLOWPILOT_S3_BUCKET=flowpilot-artifacts
FLOWPILOT_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Replace with a high-entropy KMS-backed or 32+ byte secret in production
FLOWPILOT_MASTER_KEY=change-me-to-a-strong-random-master-secret
FLOWPILOT_ACTIVE_KEY_ID=local-v1

# PostgreSQL / MinIO (Docker Compose)
POSTGRES_USER=flowpilot
POSTGRES_PASSWORD=flowpilot
POSTGRES_DB=flowpilot
MINIO_ROOT_USER=flowpilot
MINIO_ROOT_PASSWORD=flowpilot-minio-dev

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:8000
